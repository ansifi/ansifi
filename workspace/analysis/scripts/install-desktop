#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DESKTOP_DIR="${HOME}/.local/share/applications"
ICON_PATH="${ROOT}/desktop/icon.svg"
LAUNCHER="${ROOT}/scripts/desktop-start"

mkdir -p "${DESKTOP_DIR}"
rm -f "${DESKTOP_DIR}/empever-coding-agent.desktop"

cat > "${DESKTOP_DIR}/coding-agent.desktop" <<EOF
[Desktop Entry]
Version=1.0
Type=Application
Name=Coding Agent
GenericName=AI Coding Workspace
Comment=Local AI coding workspace for Ubuntu
Exec=${LAUNCHER}
Icon=${ICON_PATH}
Terminal=false
Categories=Development;IDE;
StartupWMClass=Coding Agent
EOF

chmod +x "${LAUNCHER}"
update-desktop-database "${DESKTOP_DIR}" 2>/dev/null || true

echo "Installed launcher to ${DESKTOP_DIR}/coding-agent.desktop"
echo "You can now open Coding Agent from the Ubuntu applications menu."
